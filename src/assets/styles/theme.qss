/* VoxLocal — 方案 E：macOS × Notion 极简原生风 (light) */

QWidget {
    background-color: #f5f5f7;
    color: #111827;
    font-family: "SF Pro Text", "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 13px;
    selection-background-color: rgba(0, 122, 255, 0.10);
    selection-color: #111827;
}

QMainWindow {
    background-color: #f5f5f7;
}

/* ===== 顶部 Header ===== */
QWidget#header {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}

QLabel#header_title {
    font-size: 17px;
    font-weight: 700;
    color: #111827;
    background: transparent;
}

QLabel#header_subtitle {
    font-size: 12px;
    color: #9ca3af;
    background: transparent;
}

QLabel#header_version {
    font-size: 11px;
    color: #9ca3af;
    background: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 2px 8px;
}

/* 主题切换分段器 */
QFrame#theme_switch_box {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QPushButton#theme_btn_active {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

QPushButton#theme_btn_inactive {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 500;
}

QPushButton#theme_btn_inactive:hover {
    color: #111827;
    background-color: #eceef1;
}

/* ===== 通用卡片 ===== */
QFrame#card, QFrame#notion_panel {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

QFrame#subtle_inner_card {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QLabel {
    color: #111827;
    background: transparent;
}

QLabel#section_title {
    color: #9ca3af;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.6px;
    background: transparent;
}

QLabel#panel_title {
    color: #111827;
    font-size: 13.5px;
    font-weight: 700;
    background: transparent;
}

QLabel#cloud_pill {
    background-color: rgba(0, 122, 255, 0.10);
    border: 1px solid rgba(0, 122, 255, 0.28);
    color: #007aff;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 9px;
}

QLabel#voice_quick_tag {
    background-color: #f7f7f8;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 6px;
}

QLabel#speed_badge {
    background-color: rgba(0, 122, 255, 0.10);
    border: 1px solid rgba(0, 122, 255, 0.28);
    color: #007aff;
    font-size: 11.5px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
}

QLabel#char_count, QLabel#time_label {
    color: #9ca3af;
    font-size: 11.5px;
    background: transparent;
}

QFrame#neural_spec_card {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QLabel#neural_spec_title {
    color: #111827;
    font-size: 11.5px;
    font-weight: 600;
    background: transparent;
}

QLabel#neural_spec_body {
    color: #4b5563;
    font-size: 11px;
    background: transparent;
}

/* ===== 分段按钮 & 芯片按钮 ===== */
QFrame#segment_box {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 9px;
}

QPushButton#seg_btn_active {
    background-color: #ffffff;
    color: #007aff;
    border: 1px solid #e5e7eb;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 10px;
}

QPushButton#seg_btn_inactive {
    background-color: transparent;
    color: #4b5563;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    padding: 6px 10px;
}

QPushButton#seg_btn_inactive:hover {
    color: #111827;
    background-color: #eceef1;
}

QPushButton#chip_btn {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    color: #4b5563;
    padding: 5px 0;
    font-size: 11px;
    font-weight: 500;
}

QPushButton#chip_btn:hover {
    background-color: #eceef1;
    color: #111827;
    border-color: #d1d5db;
}

QPushButton#chip_btn_active {
    background-color: rgba(0, 122, 255, 0.10);
    border: 1px solid rgba(0, 122, 255, 0.28);
    color: #007aff;
    border-radius: 6px;
    padding: 5px 0;
    font-size: 11px;
    font-weight: 600;
}

/* ===== 文本输入框 ===== */
QPlainTextEdit {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    selection-background-color: rgba(0, 122, 255, 0.10);
}

QPlainTextEdit:focus {
    border: 1.5px solid #007aff;
}

/* ===== 通用按钮 ===== */
QPushButton {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 7px 15px;
    font-size: 12.5px;
    font-weight: 500;
}

QPushButton:hover:enabled {
    background-color: #f7f7f8;
}

QPushButton:pressed:enabled {
    background-color: #e2e5ea;
}

QPushButton:disabled {
    background-color: #f7f7f8;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QPushButton#btn_ghost {
    background-color: transparent;
    color: #4b5563;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px 10px;
    font-size: 12.5px;
    font-weight: 500;
}

QPushButton#btn_ghost:hover:enabled {
    background-color: #f7f7f8;
    color: #111827;
}

QPushButton#btn_generate {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 10px 28px;
    font-size: 14px;
    font-weight: 600;
    min-height: 42px;
}

QPushButton#btn_generate:hover:enabled {
    background-color: #0066d6;
}

QPushButton#btn_generate:pressed:enabled {
    background-color: #0055b3;
}

QPushButton#btn_generate:disabled {
    background-color: #f7f7f8;
    color: #9ca3af;
    border: 1px solid #e5e7eb;
}

/* ===== 下拉框 ===== */
QComboBox {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12.5px;
    font-weight: 500;
    min-height: 30px;
}

QComboBox:hover {
    border-color: #007aff;
}

QComboBox::drop-down {
    border: none;
    width: 22px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4b5563;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    selection-background-color: rgba(0, 122, 255, 0.10);
    selection-color: #007aff;
    outline: none;
    padding: 4px;
}

/* ===== 滑块 ===== */
QSlider::groove:horizontal {
    background-color: #e5e7eb;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #ffffff;
    border: 1.5px solid #007aff;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #007aff;
}

QSlider::sub-page:horizontal {
    background-color: #007aff;
    border-radius: 2px;
}

/* ===== 进度条 ===== */
QProgressBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 3px;
    height: 5px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #007aff;
    border-radius: 3px;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
}
QScrollBar::handle:vertical {
    background-color: #d1d5db;
    border-radius: 3px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #9ca3af;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal {
    background-color: #d1d5db;
    border-radius: 3px;
    min-width: 20px;
}

/* ===== 标签页 QTabWidget ===== */
QTabWidget::pane {
    border: none;
    border-top: 1px solid #e5e7eb;
    background-color: transparent;
    top: -1px;
    padding-top: 10px;
}

QTabBar::tab {
    background-color: #f7f7f8;
    color: #4b5563;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    padding: 7px 18px;
    margin-right: 4px;
    font-size: 13px;
    font-weight: 500;
    min-width: 112px;
}

QTabBar::tab:hover {
    background-color: #eceef1;
    color: #111827;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #007aff;
    border: 1px solid #e5e7eb;
    border-bottom: 2px solid #ffffff;
    font-weight: 600;
}

/* 透明容器（绝不用无选择器 inline background:transparent 污染子控件） */
QWidget#transparent_box, QScrollArea#transparent_scroll {
    background-color: transparent;
    border: none;
}

/* ===== 状态栏 ===== */
QWidget#status_bar {
    background-color: #ffffff;
    border-top: 1px solid #e5e7eb;
}

/* ===== 沉浸跟读台（方案 E：macOS × Notion） ===== */
QFrame#focus_window_card {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

QWidget#focus_toolbar {
    background-color: #f7f7f8;
    border-bottom: 1px solid #e5e7eb;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

QFrame#notion_steps_box {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QLabel#step_active {
    background-color: rgba(0, 122, 255, 0.10);
    color: #007aff;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#step_done {
    background-color: transparent;
    color: #248a3d;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 600;
}

QLabel#step_idle {
    background-color: transparent;
    color: #9ca3af;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 500;
}

QLabel#prop_chip {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    color: #4b5563;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 500;
}

QLabel#prop_chip_rec {
    background-color: rgba(255, 59, 48, 0.08);
    border: 1px solid rgba(255, 59, 48, 0.26);
    color: #ff3b30;
    border-radius: 6px;
    padding: 3px 9px;
    font-size: 11.5px;
    font-weight: 600;
}

QFrame#blind_callout {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}

QFrame#blind_callout_rec {
    background-color: rgba(255, 59, 48, 0.08);
    border: 1px solid rgba(255, 59, 48, 0.26);
    border-radius: 12px;
}

QLabel#lock_pill {
    background-color: rgba(137, 68, 171, 0.09);
    border: 1px solid rgba(137, 68, 171, 0.28);
    color: #8944ab;
    border-radius: 6px;
    padding: 3px 10px;
    font-size: 11.5px;
    font-weight: 600;
}

QPlainTextEdit#focus_write_input {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    padding: 13px 15px;
    font-size: 17px;
}

QPlainTextEdit#focus_write_input:focus {
    border: 2px solid #8944ab;
}

QFrame#diff_card_user {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
}

QFrame#diff_card_orig {
    background-color: rgba(0, 122, 255, 0.10);
    border: 1px solid rgba(0, 122, 255, 0.28);
    border-radius: 10px;
}

QWidget#focus_footer {
    background-color: #f7f7f8;
    border-top: 1px solid #e5e7eb;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

QFrame#native_param_pill {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

QFrame#stepper_box {
    background-color: #f7f7f8;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
}

QPushButton#stepper_btn {
    background-color: transparent;
    color: #111827;
    border: none;
    border-radius: 4px;
    padding: 0px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton#stepper_btn:hover:enabled {
    background-color: #eceef1;
}

QPushButton#stepper_btn:disabled {
    color: #9ca3af;
}

QSpinBox#stepper_spin {
    background-color: transparent;
    color: #111827;
    border: none;
    padding: 0px 2px;
    font-size: 12px;
    font-weight: 600;
}

QSpinBox#stepper_spin:disabled {
    color: #9ca3af;
}

/* 核心主按钮态 */
QPushButton#btn_record_idle {
    background-color: #007aff;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_record_idle:hover:enabled {
    background-color: #0066d6;
}

QPushButton#btn_record_active {
    background-color: #ff3b30;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_record_active:hover:enabled {
    background-color: #e0352b;
}

QPushButton#btn_write, QPushButton#btn_submit_write {
    background-color: #8944ab;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_write:hover:enabled, QPushButton#btn_submit_write:hover:enabled {
    background-color: #733593;
}
QPushButton#btn_submit_write:disabled {
    background-color: #eceef1;
    color: #9ca3af;
}

QPushButton#btn_confirm_ok {
    background-color: #248a3d;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 0 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton#btn_confirm_ok:hover:enabled {
    background-color: #1e7533;
}

QPushButton#btn_replay_rec {
    background-color: rgba(0, 122, 255, 0.10);
    color: #007aff;
    border: 1px solid rgba(0, 122, 255, 0.28);
    border-radius: 8px;
    padding: 0 13px;
    font-size: 12.5px;
    font-weight: 600;
}
QPushButton#btn_replay_rec:hover:enabled {
    background-color: rgba(0, 122, 255, 0.28);
}
QPushButton#btn_replay_rec:disabled {
    background-color: #f7f7f8;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QToolTip {
    background-color: #ffffff;
    color: #111827;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

QMessageBox {
    background-color: #ffffff;
}
QMessageBox QLabel {
    color: #111827;
}
