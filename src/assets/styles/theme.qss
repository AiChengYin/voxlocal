/* VoxLocal — Qt 样式表 (深色主题 + 互联网审美) */

/* ===== 全局基础 ===== */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Inter", sans-serif;
    font-size: 13px;
    selection-background-color: #388bfd40;
    selection-color: #e6edf3;
}

QMainWindow {
    background-color: #0d1117;
}

/* ===== 卡片面板 ===== */
QFrame#card {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
    padding: 4px;
}

QFrame#card_highlight {
    background-color: #161b22;
    border: 1px solid #388bfd;
    border-radius: 12px;
}

/* ===== 标签 ===== */
QLabel {
    color: #e6edf3;
    background: transparent;
}

QLabel#section_title {
    color: #8b949e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: transparent;
}

QLabel#engine_name {
    color: #e6edf3;
    font-size: 18px;
    font-weight: 700;
    background: transparent;
}

QLabel#engine_desc {
    color: #8b949e;
    font-size: 12px;
    background: transparent;
}

QLabel#badge_local {
    background-color: #1f6feb30;
    color: #388bfd;
    border: 1px solid #388bfd50;
    border-radius: 4px;
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#badge_cloud {
    background-color: #6e40c930;
    color: #a371f7;
    border: 1px solid #6e40c950;
    border-radius: 4px;
    padding: 1px 7px;
    font-size: 10px;
    font-weight: 700;
}

QLabel#status_ready {
    color: #3fb950;
    font-size: 12px;
    background: transparent;
}

QLabel#status_unavail {
    color: #f85149;
    font-size: 12px;
    background: transparent;
}

QLabel#char_count {
    color: #8b949e;
    font-size: 11px;
    background: transparent;
}

QLabel#time_label {
    color: #8b949e;
    font-size: 11px;
    background: transparent;
}

/* ===== 文本输入框 ===== */
QPlainTextEdit {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
    line-height: 1.6;
    selection-background-color: #388bfd50;
}

QPlainTextEdit:focus {
    border: 1px solid #388bfd;
    background-color: #0d1117;
}

/* ===== 按钮 ===== */
QPushButton {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 8px 18px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background-color: #161b22;
    border-color: #388bfd;
}

QPushButton#btn_generate {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f6feb, stop:1 #388bfd);
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px 32px;
    font-size: 14px;
    font-weight: 700;
    min-height: 44px;
}

QPushButton#btn_generate:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #388bfd, stop:1 #58a6ff);
    border: none;
}

QPushButton#btn_generate:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1158c7, stop:1 #1f6feb);
}

QPushButton#btn_generate:disabled {
    background-color: #21262d;
    color: #484f58;
    border: 1px solid #30363d;
}

QPushButton#btn_play {
    background-color: #1f6feb20;
    color: #58a6ff;
    border: 1px solid #388bfd40;
    border-radius: 20px;
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    font-size: 16px;
    padding: 0px;
}

QPushButton#btn_play:hover {
    background-color: #388bfd30;
    border-color: #388bfd;
}

QPushButton#btn_save {
    background-color: #16241a;
    color: #3fb950;
    border: 1px solid #2ea04340;
    border-radius: 8px;
    padding: 8px 18px;
}

QPushButton#btn_save:hover {
    background-color: #1e3228;
    border-color: #3fb950;
}

QPushButton#btn_stop {
    background-color: #2d1515;
    color: #f85149;
    border: 1px solid #f8514940;
    border-radius: 8px;
    padding: 8px 18px;
}

QPushButton#btn_stop:hover {
    background-color: #3d1f1f;
    border-color: #f85149;
}

QPushButton#btn_lang_active {
    background-color: #1f6feb35;
    color: #58a6ff;
    border: 1px solid #388bfd;
    border-radius: 6px;
    font-weight: 600;
    padding: 6px 12px;
}

QPushButton#btn_lang_inactive {
    background-color: #21262d;
    color: #8b949e;
    border: 1px solid #30363d;
    border-radius: 6px;
    font-weight: 500;
    padding: 6px 12px;
}

QPushButton#btn_lang_inactive:hover {
    background-color: #30363d;
    color: #e6edf3;
    border-color: #8b949e;
}

/* ===== 下拉框 ===== */
QComboBox {
    background-color: #21262d;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 13px;
    min-height: 32px;
}

QComboBox:hover {
    border-color: #8b949e;
}

QComboBox:focus {
    border-color: #388bfd;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #8b949e;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    selection-background-color: #388bfd30;
    selection-color: #e6edf3;
    outline: none;
    padding: 4px;
}

/* ===== 滑块 ===== */
QSlider::groove:horizontal {
    background-color: #21262d;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #388bfd;
    border: 2px solid #1f6feb;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #58a6ff;
    border-color: #388bfd;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f6feb, stop:1 #388bfd);
    border-radius: 2px;
}

/* ===== 进度条 ===== */
QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 4px;
    height: 6px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f6feb, stop:1 #7c3aed);
    border-radius: 4px;
}

/* ===== 语音调谐中心（方案 C：现代声波流光工作台） ===== */
QFrame#cyber_panel {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0e1526, stop:1 #0a0f1d);
    border: 1px solid rgba(99, 102, 241, 0.35);
    border-radius: 14px;
    padding: 2px;
}

QLabel#cyber_title {
    font-size: 13px;
    font-weight: 700;
    color: #f8fafc;
    background: transparent;
}

QLabel#cyber_cloud_badge {
    background: rgba(6, 182, 212, 0.15);
    border: 1px solid rgba(6, 182, 212, 0.45);
    color: #22d3ee;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 7px;
    border-radius: 10px;
    letter-spacing: 0.5px;
}

QLabel#cyber_section_title {
    font-size: 11px;
    font-weight: 700;
    color: #94a3b8;
    letter-spacing: 0.8px;
    background: transparent;
}

/* 霓虹分段切换按钮 */
QPushButton#neon_btn_active {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(99, 102, 241, 0.35), stop:1 rgba(6, 182, 212, 0.25));
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.6);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 10px;
}

QPushButton#neon_btn_inactive {
    background-color: rgba(15, 23, 42, 0.6);
    color: #94a3b8;
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 10px;
}

QPushButton#neon_btn_inactive:hover {
    background-color: rgba(30, 41, 59, 0.7);
    color: #f8fafc;
    border-color: rgba(99, 102, 241, 0.4);
}

/* 内嵌卡片与音色标签 */
QFrame#cyber_card_inner {
    background-color: rgba(15, 23, 42, 0.65);
    border: 1px solid rgba(51, 65, 85, 0.75);
    border-radius: 10px;
}

QLabel#voice_quick_tag {
    background: rgba(99, 102, 241, 0.18);
    color: #818cf8;
    border: 1px solid rgba(99, 102, 241, 0.35);
    font-size: 10px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 4px;
}

/* 角色下拉框 */
QComboBox#cyber_combo {
    background-color: transparent;
    color: #f8fafc;
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 600;
}

QComboBox#cyber_combo:hover, QComboBox#cyber_combo:focus {
    border-color: #38bdf8;
}

/* 语速速率指示与滑块 */
QLabel#speed_cyber_badge {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    font-family: monospace;
    font-size: 12px;
    font-weight: 700;
    padding: 1px 7px;
    border-radius: 4px;
}

QSlider#cyber_slider::groove:horizontal {
    background-color: #1e293b;
    height: 5px;
    border-radius: 2px;
}

QSlider#cyber_slider::handle:horizontal {
    background: #f8fafc;
    border: 2px solid #06b6d4;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

QSlider#cyber_slider::handle:horizontal:hover {
    background: #ffffff;
    border-color: #38bdf8;
}

QSlider#cyber_slider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #06b6d4);
    border-radius: 2px;
}

/* 芯片预设档位按键 */
QPushButton#chip_btn {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(51, 65, 85, 0.8);
    border-radius: 6px;
    color: #94a3b8;
    padding: 5px 0;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#chip_btn:hover {
    color: #f8fafc;
    border-color: #38bdf8;
}

QPushButton#chip_btn_active {
    background-color: rgba(6, 182, 212, 0.18);
    border: 1px solid #06b6d4;
    color: #22d3ee;
    border-radius: 6px;
    padding: 5px 0;
    font-size: 11px;
    font-weight: 700;
}

/* 神经规格注脚卡片 */
QFrame#neural_spec_card {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(99, 102, 241, 0.08), stop:1 rgba(6, 182, 212, 0.05));
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 8px;
}

QLabel#neural_spec_title {
    color: #818cf8;
    font-size: 11px;
    font-weight: 700;
    background: transparent;
}

QLabel#neural_spec_body {
    color: #94a3b8;
    font-size: 10px;
    line-height: 1.4;
    background: transparent;
}

/* ===== 列表 ===== */
QListWidget {
    background-color: #0d1117;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #21262d;
}

QListWidget::item:selected {
    background-color: #388bfd20;
    color: #58a6ff;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #30363d;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal {
    background-color: #30363d;
    border-radius: 3px;
    min-width: 20px;
}

/* ===== 分割线 ===== */
QFrame#separator {
    background-color: #21262d;
    max-height: 1px;
    border: none;
}

/* ===== 工具提示 ===== */
QToolTip {
    background-color: #161b22;
    color: #e6edf3;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: 12px;
}

/* ===== 标签页控件 QTabWidget ===== */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 10px;
    background-color: #0d1117;
    top: -1px;
}

QTabBar::tab {
    background-color: #161b22;
    color: #8b949e;
    border: 1px solid #30363d;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-size: 13px;
    font-weight: 600;
    min-width: 110px;
}

QTabBar::tab:hover {
    background-color: #21262d;
    color: #e6edf3;
    border-color: #388bfd50;
}

QTabBar::tab:selected {
    background-color: #0d1117;
    color: #58a6ff;
    border: 1px solid #388bfd;
    border-bottom: 2px solid #0d1117;
}
